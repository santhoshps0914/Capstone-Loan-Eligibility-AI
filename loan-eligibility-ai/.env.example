# Copy to `.env` and fill in ONE of the two provider keys.
# `.env` is gitignored — never commit real keys.

# Option A: OpenRouter (OpenAI-compatible gateway, reaches Claude models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5

# Option B: native Anthropic API (takes precedence if both are set)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Reasoning effort for chat replies: low | medium | high | xhigh | max
CHAT_EFFORT=medium
